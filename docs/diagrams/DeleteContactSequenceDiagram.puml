@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant "d:DeleteContactCommand" as DeleteContactCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant ":UniquePersonList" as UniquePersonList MODEL_COLOR
end box

[-> DeleteContactCommand : execute(m)
activate DeleteContactCommand

DeleteContactCommand -> ModelManager : deleteContact("S1")
activate ModelManager

ModelManager -> AddressBook : deleteContact("S1")
activate AddressBook

AddressBook -> AddressBook : removePerson(s)
activate AddressBook

AddressBook -> UniquePersonList : remove(s)
activate UniquePersonList

UniquePersonList --> AddressBook
deactivate UniquePersonList

loop each tag of s
    AddressBook -> AddressBook : removeLinksInvolving(tagName)
    activate AddressBook

    AddressBook --> AddressBook
    deactivate AddressBook
end

AddressBook --> AddressBook
deactivate AddressBook

AddressBook --> ModelManager : true
deactivate AddressBook

ModelManager -> ModelManager : updateFilteredPersonList(PREDICATE_SHOW_ALL_PERSONS)
activate ModelManager

ModelManager --> ModelManager
deactivate ModelManager

ModelManager --> DeleteContactCommand : true
deactivate ModelManager

[<-- DeleteContactCommand : r
deactivate DeleteContactCommand
@enduml
